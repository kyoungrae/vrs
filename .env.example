APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_LOG=single
# 로컬: php artisan serve 를 쓰면 브라우저와 반드시 동일한 호스트·포트 (예: http://127.0.0.1:8000).
#       APP_URL=http://localhost 처럼 포트를 빼면 asset()이 http://localhost/css/...(:80)으로 생성되어
#       CSS·이미지가 NS_ERROR 로 전부 실패할 수 있음.
# 로컬: 루트에 둘 때
#   APP_URL=http://127.0.0.1:8000
# 운영: 대표 URL(artisan·메일·스케줄 등 비HTTP 에서 생성되는 링크용). 끝 슬래시 없이.
#   APP_URL=http://210.92.92.18:2000/vrs
# 웹 브라우저의 asset()/url()/route() 는 ForceLocalApplicationUrl 이 접속한 호스트(내부 IP·공인 IP)에 맞춤.
# 로컬/운영은 코드가 아니라 .env 만 분리하면 됩니다.
APP_URL=http://127.0.0.1:8000

# Docker: docker-compose.dev.yml 의 app 서비스는 profile "app" 이라 아래 중 하나 필요
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile app up -d
#   또는 이 줄 주석 해제: COMPOSE_PROFILES=app
# COMPOSE_PROFILES=app

# Oracle (yajra/laravel-oci8). Get host/service/user from your DBA or use local Docker (see docs/LOCAL_SETUP.md).
DB_CONNECTION=oracle
DB_HOST=127.0.0.1
DB_PORT=1521
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SERVICE_NAME=

SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Local UI without Oracle (never enable in production) ---
# DEV_BYPASS_LOGIN=true
# DEV_BYPASS_USER_ID=1
# DEV_BYPASS_LASTNAME=DEV
# DEV_BYPASS_FIRSTNAME=Local
# DEV_BYPASS_POSITION=Мэргэжилтэн
# DEV_BYPASS_PROVINCE_ID=22
# DEV_BYPASS_POSITION_ID=1
# DEV_BYPASS_IS_ATVT=0
# DEV_BYPASS_IS_CITY=1
# DEV_BYPASS_ARCHIVE_ID=1
# DEV_BYPASS_ARCHIVE_LABEL=LOCAL-DEV
# DEV_BYPASS_ARCHIVE_ABBR=DEV
# Open: http://127.0.0.1:8000/dev/local-login (or use button on login page)
# REAL_UI_WITHOUT_DB=true  (기본 권장) 실제 Blade 화면을 빈 데이터로 표시. false면 경량 데모 안내 페이지만 사용.
# SKIP_EXTERNAL_FONTS=true  로컬에서 Google Fonts 요청 생략(첫 화면 체감 속도↑). 운영에서는 보통 false.
# DB_OFFLINE_UI=  비우면: REAL_UI_WITHOUT_DB=true 일 때 Oracle 대신 storage/framework/offline-ui.sqlite 로 default 연결(타임아웃 방지).
# DB_OFFLINE_UI=false  로컬에서도 Oracle 기본 연결 유지(실 DB 테스트용).

# Optional: docker compose oracle service password (must match DB_PASSWORD if using default system user)
# LOCAL_ORACLE_PASSWORD=DevOraclePass123
# LOCAL_ORACLE_PORT=1521
